# Anthropic API key — required for job analysis, CV tailoring, cover letters, Q&A.
# Without it the agent still scans/dedupes/prefilters; LLM steps are skipped with a logged warning.
ANTHROPIC_API_KEY=

# Models (defaults shown). Primary: analysis + documents. Fast: cheap classification.
JH_MODEL_PRIMARY=claude-sonnet-5
JH_MODEL_FAST=claude-haiku-4-5-20251001

# Server
JH_PORT=8790

# Storage (paths relative to the job-hunter/ directory)
JH_DB_PATH=data/jobhunter.db
JH_DATA_DIR=data

# Agent
JH_AGENT_AUTOSTART=true          # start the background loop with the server
JH_AGENT_INTERVAL_MIN=45         # minutes between agent cycles (each cycle scans only sources that are due)

# Browser automation
# Set if Playwright cannot find its Chromium (e.g. preinstalled browsers):
# JH_CHROMIUM_PATH=/usr/bin/chromium
JH_APPLY_ENABLED=true            # master switch for the applier worker
